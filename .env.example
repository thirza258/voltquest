# Copy to .env and adjust. docker compose reads this file automatically.

# Postgres password (docker-compose.yml only).
POSTGRES_PASSWORD=voltquest

# Signs player JWTs. Use a long random value in any shared deployment.
JWT_SECRET=dev-secret-change-me

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Host port for the web client.
WEB_PORT=8080

# Public frontend origin embedded in certificate PDF verification links and QR codes.
# Use https://pcb.nevatal.id on that deployment; use http://localhost:5173 for Vite development.
PUBLIC_APP_URL=http://localhost:8080

# Local dev only (vite dev server): where the frontend proxies /api.
# VITE_PROXY_TARGET=http://localhost:8000

# Optional circuit tutor. Server-side only; never put this key in VITE_* variables.
# Local development: set these in backend/.env or export them in the API shell.
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4.1-mini

# MCP transport host allowlist. Add your hostname when deploying to another domain.
MCP_ALLOWED_HOSTS=pcb.nevatal.id,localhost,localhost:*,127.0.0.1,127.0.0.1:*,backend:8000,testserver
