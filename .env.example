# Copy to .env and adjust. docker compose reads this file automatically.

# Postgres password (docker-compose.yml only).
POSTGRES_PASSWORD=voltquest

# Signs player JWTs. Use a long random value in any shared deployment.
JWT_SECRET=dev-secret-change-me

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Host port for the web client.
WEB_PORT=8080

# Local dev only (vite dev server): where the frontend proxies /api.
# VITE_PROXY_TARGET=http://localhost:8000
