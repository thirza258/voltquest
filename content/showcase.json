      "code": "#include <WiFi.h>\n#include <PubSubClient.h>\n#include <DHT.h>\nWiFiClient network;\nPubSubClient mqtt(network);\nDHT sensor(23, DHT22);\nvoid setup() {\n  Serial.begin(115200);\n  sensor.begin();\n  WiFi.begin(\"VoltNet\", \"pass\");\n  while (WiFi.status() != WL_CONNECTED) delay(50);\n  mqtt.setServer(\"broker.voltquest.local\", 1883);\n  mqtt.connect(\"weather-station\");\n}\nvoid loop() {\n  mqtt.loop();\n  float temperature = sensor.readTemperature();\n  String payload = String(temperature);\n  mqtt.publish(\"weather/temperature\", payload.c_str());\n  Serial.println(payload);\n  delay(500);\n}\n"
