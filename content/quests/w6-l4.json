    "code": "#include <Servo.h>\nServo arm;\nbool enabledBefore = false;\nvoid setup() { Serial.begin(115200); pinMode(2, INPUT_PULLUP); arm.attach(9); arm.write(90); }\nvoid loop() {\n  bool enabled = digitalRead(2) == LOW;\n  int angle = 90;\n  if (enabled) angle = constrain(map(analogRead(A0), 0, 1023, 0, 180), 30, 150);\n  arm.write(angle);\n  if (!enabled && enabledBefore) Serial.println(\"PARK\");\n  enabledBefore = enabled;\n}\n",
