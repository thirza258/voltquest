    "code": "#include <Adafruit_BME280.h>\n#include <LiquidCrystal_I2C.h>\nAdafruit_BME280 sensor;\nLiquidCrystal_I2C lcd(0x27, 16, 2);\nunsigned long sampledAt = 0;\nvoid setup() { Serial.begin(115200); sensor.begin(0x76); lcd.init(); lcd.backlight(); }\nvoid loop() {\n  if (millis() - sampledAt < 250) return;\n  sampledAt = millis();\n  float t = sensor.readTemperature();\n  float h = sensor.readHumidity();\n  lcd.clear(); lcd.setCursor(0, 0); lcd.print(\"T=\"); lcd.print(t, 1); lcd.print(\" C\");\n  lcd.setCursor(0, 1); lcd.print(\"H=\"); lcd.print(h, 1); lcd.print(\" %\");\n  Serial.print(t, 1); Serial.print(\",\"); Serial.println(h, 1);\n}\n",
