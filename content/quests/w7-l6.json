    "code": "#include <WiFi.h>\n#include <WebServer.h>\n#include <PubSubClient.h>\n#include <Adafruit_BME280.h>\n#include <ESP32Servo.h>\nWiFiClient network;\nPubSubClient mqtt(network);\nWebServer server(80);\nAdafruit_BME280 sensor;\nServo vent;\nString mode = \"AUTO\";\nfloat temperature = 24.5;\nbool opened = false;\nunsigned long sampledAt = 0;\nunsigned long publishedAt = 0;\nvoid applyControl() {\n  if (mode == \"OPEN\") opened = true;\n  else if (mode == \"CLOSE\") opened = false;\n  else {\n    if (temperature >= 30) opened = true;\n    if (temperature <= 27) opened = false;\n  }\n  vent.write(opened ? 150 : 30); digitalWrite(23, opened);\n}\nString statusText() {\n  return \"mode=\" + mode + \";temp=\" + String(temperature, 1) + \";vent=\" + (opened ? \"OPEN\" : \"CLOSED\");\n}\nvoid command(char* topic, byte* payload, unsigned int length) {\n  String text = \"\";\n  for (unsigned int i = 0; i < length; i++) text += char(payload[i]);\n  if (text == \"AUTO\" || text == \"OPEN\" || text == \"CLOSE\") {\n    mode = text; applyControl(); mqtt.publish(\"greenhouse/mode/state\", mode.c_str());\n  } else mqtt.publish(\"greenhouse/error\", \"INVALID\");\n}\nvoid setup() {\n  Serial.begin(115200); pinMode(23, OUTPUT); vent.attach(18); vent.write(30);\n  sensor.begin(0x76);\n  WiFi.begin(\"VoltNet\", \"pass\");\n  while (WiFi.status() != WL_CONNECTED) delay(20);\n  mqtt.setServer(\"broker.voltquest.local\", 1883); mqtt.setCallback(command);\n  mqtt.connect(\"greenhouse\"); mqtt.subscribe(\"greenhouse/mode\");\n  server.on(\"/status\", []() { server.send(200, \"text/plain\", statusText()); }); server.begin();\n}\nvoid loop() {\n  if (millis() - sampledAt >= 100) { sampledAt = millis(); temperature = sensor.readTemperature(); applyControl(); }\n  mqtt.loop(); server.handleClient();\n  if (millis() - publishedAt >= 500) { publishedAt = millis(); String report = statusText(); mqtt.publish(\"greenhouse/status\", report.c_str()); }\n}\n",
