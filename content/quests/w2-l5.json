    "code": "int leds[3] = {9, 10, 11};\nint buttons[3] = {2, 3, 4};\nint sequence[3];\nint step = 0;\nbool held = false;\nvoid setup() {\n  Serial.begin(9600);\n  randomSeed(42);\n  for (int i = 0; i < 3; i++) {\n    pinMode(leds[i], OUTPUT);\n    pinMode(buttons[i], INPUT_PULLUP);\n    sequence[i] = random(3);\n  }\n  Serial.println(\"Watch the three flashes\");\n  for (int i = 0; i < 3; i++) {\n    Serial.println(sequence[i]);\n    digitalWrite(leds[sequence[i]], HIGH); delay(400);\n    digitalWrite(leds[sequence[i]], LOW); delay(200);\n  }\n  Serial.println(\"Repeat the sequence\");\n}\nvoid loop() {\n  int pressed = -1;\n  for (int i = 0; i < 3; i++) {\n    if (digitalRead(buttons[i]) == LOW) pressed = i;\n  }\n  if (pressed < 0) held = false;\n  if (pressed >= 0 && !held && step < 3) {\n    held = true;\n    if (pressed == sequence[step]) {\n      step++;\n      if (step == 3) Serial.println(\"Sequence complete!\");\n    } else {\n      step = 0;\n      Serial.println(\"Try again from the first color\");\n    }\n  }\n  delay(20);\n}\n",
