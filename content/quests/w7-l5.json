    "code": "int samples[5];\nint cursor = 0;\nint filled = 0;\nunsigned long sampledAt = 0;\nunsigned long beatAt = 0;\nbool beat = false;\nvoid setup() {\n  Serial.begin(115200); pinMode(18, OUTPUT); pinMode(19, INPUT);\n  pinMode(23, OUTPUT); pinMode(2, OUTPUT);\n}\nvoid loop() {\n  unsigned long now = millis();\n  if (now - beatAt >= 100) { beatAt = now; beat = !beat; digitalWrite(2, beat); }\n  if (now - sampledAt < 60) return;\n  sampledAt = now;\n  digitalWrite(18, LOW); delayMicroseconds(2);\n  digitalWrite(18, HIGH); delayMicroseconds(10); digitalWrite(18, LOW);\n  unsigned long duration = pulseIn(19, HIGH, 25000);\n  if (duration == 0) { filled = 0; cursor = 0; digitalWrite(23, LOW); return; }\n  samples[cursor] = round(duration / 58.3); cursor = (cursor + 1) % 5;\n  if (filled < 5) filled++;\n  if (filled < 5) return;\n  int sorted[5];\n  for (int i = 0; i < 5; i++) sorted[i] = samples[i];\n  for (int i = 1; i < 5; i++) {\n    int value = sorted[i]; int j = i - 1;\n    while (j >= 0 && sorted[j] > value) { sorted[j + 1] = sorted[j]; j--; }\n    sorted[j + 1] = value;\n  }\n  int median = sorted[2]; bool near = median < 50;\n  digitalWrite(23, near);\n  Serial.print(\"MEDIAN=\"); Serial.print(median); Serial.println(near ? \";NEAR\" : \";CLEAR\");\n}\n",
