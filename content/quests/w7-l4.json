    "code": "#include <WiFi.h>\n#include <WebServer.h>\n#include <DHT.h>\nDHT sensor(23, DHT22);\nWebServer server(80);\nbool alarm = false;\nfloat temperature = 0;\nfloat humidity = 0;\nint limit = 30;\nunsigned long sampledAt = 0;\nString statusText() {\n  return \"t=\" + String(temperature, 1) + \";limit=\" + String(limit) + \";h=\" + String(humidity, 1) + \";alarm=\" + (alarm ? \"ON\" : \"OFF\");\n}\nvoid setup() {\n  Serial.begin(115200); pinMode(18, OUTPUT); sensor.begin();\n  WiFi.begin(\"VoltNet\", \"pass\");\n  server.on(\"/status\", []() { server.send(200, \"text/plain\", statusText()); }); server.begin();\n}\nvoid loop() {\n  if (millis() - sampledAt >= 100) {\n    sampledAt = millis();\n    temperature = sensor.readTemperature(); humidity = sensor.readHumidity();\n    limit = map(analogRead(34), 0, 4095, 20, 40);\n    if (temperature >= limit && humidity >= 70) alarm = true;\n    if (temperature <= limit - 2 || humidity <= 65) alarm = false;\n    digitalWrite(18, alarm);\n  }\n  server.handleClient();\n}\n",
