  "starterCode": "#include <MPU6050.h>\nMPU6050 imu;\nvoid setup() {\n  Serial.begin(115200);\n  imu.begin();\n}\nvoid loop() {\n  Serial.print(\"Roll: \"); Serial.print(imu.getRoll(), 1);\n  Serial.print(\" Pitch: \"); Serial.println(imu.getPitch(), 1);\n  delay(100);\n}\n",
  "starterBlocklyXml": null,
  "allowedComponents": null,
  "objectives": [
    {
      "id": "read",
      "text": "Read the connected IMU and print roll / pitch",
      "rules": [
        {
          "type": "imu_read_seen",
          "minSamples": 20
        },
        {
          "type": "serial_matches",
          "pattern": "Roll: 1[45]\\.[0-9] Pitch: -(9\\.[0-9]|10\\.[0-9])"
        }
      ],
      "hints": {
        "tier1": "Gravity projects onto the accelerometer axes when the frame tilts.",
        "tier2": {
          "text": "Use MPU6050.getRoll() and getPitch(). On the stand, set roll to +15° and pitch to −10°. Print both at 115200 baud.",
          "componentTypes": [
            "esc",
