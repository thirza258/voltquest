    "code": "int phase = 0;\nint previous = HIGH;\nunsigned long enteredAt = 0;\nvoid setup() {\n  Serial.begin(115200); pinMode(2, INPUT_PULLUP);\n  pinMode(9, OUTPUT); pinMode(10, OUTPUT); pinMode(11, OUTPUT);\n  digitalWrite(9, HIGH); Serial.println(\"READY\");\n}\nvoid loop() {\n  unsigned long now = millis();\n  int reading = digitalRead(2);\n  if (phase == 0 && reading == LOW && previous == HIGH) { phase = 1; enteredAt = now; Serial.println(\"WAIT\"); }\n  previous = reading;\n  if (phase == 1 && now - enteredAt >= 500) {\n    digitalWrite(9, LOW); digitalWrite(10, HIGH); phase = 2; enteredAt = now;\n  } else if (phase == 2 && now - enteredAt >= 250) {\n    digitalWrite(11, HIGH); Serial.println(\"CROSS\"); phase = 3; enteredAt = now;\n  } else if (phase == 3 && now - enteredAt >= 1000) {\n    digitalWrite(11, LOW); Serial.println(\"CLEAR\"); phase = 4; enteredAt = now;\n  } else if (phase == 4 && now - enteredAt >= 250) {\n    digitalWrite(10, LOW); digitalWrite(9, HIGH); Serial.println(\"READY\"); phase = 0;\n  }\n}\n",
